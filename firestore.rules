rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "boogiilive@gmail.com");
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['name', 'phone', 'email', 'optionId', 'optionTitle', 'checkIn', 'checkOut', 'status', 'createdAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 20 &&
        data.optionId is string &&
        data.optionTitle is string &&
        data.checkIn is string &&
        data.checkOut is string &&
        data.status in ['pending', 'confirmed', 'cancelled', 'completed'];
    }

    function isValidNews(data) {
      return data.keys().hasAll(['title', 'content', 'createdAt']) &&
        data.title is string && data.title.size() > 0 &&
        data.content is string && data.content.size() > 0;
    }

    function isValidGallery(data) {
      return data.keys().hasAll(['image', 'category', 'caption', 'createdAt']) &&
        data.image is string && data.image.size() > 0 &&
        data.category is string && data.category.size() > 0 &&
        data.caption is string && data.caption.size() > 0;
    }

    // Bookings collection rules
    match /bookings/{bookingId} {
      // Anyone can create a booking to make a reservation, or admins can do it
      allow create: if isValidBooking(request.resource.data) || isAdmin();
      
      // Anyone needs to read existing bookings to block dates in the calendar
      allow read: if true;
      
      // Only admins can update or delete bookings
      allow update, delete: if isAdmin();
    }

    // News collection rules
    match /news/{newsId} {
      // Anyone can view the news posts
      allow read: if true;
      
      // Only admins can write, update, or delete news posts
      allow create, update, delete: if isAdmin() && isValidNews(request.resource.data);
    }

    // Gallery collection rules
    match /gallery/{galleryId} {
      // Anyone can view gallery images
      allow read: if true;
      
      // Only admins can write, update, or delete gallery posts
      allow create, update, delete: if isAdmin() && isValidGallery(request.resource.data);
    }
  }
}
