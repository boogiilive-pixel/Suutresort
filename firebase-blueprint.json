{
  "entities": {
    "booking": {
      "title": "Booking",
      "description": "A booking for a house or room.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Customer name" },
        "phone": { "type": "string", "description": "Customer phone number" },
        "email": { "type": "string", "description": "Customer email" },
        "guests": { "type": "integer", "description": "Number of guests" },
        "optionId": { "type": "string", "description": "ID of the house or room" },
        "optionTitle": { "type": "string", "description": "Title of the house or room" },
        "date": { "type": "string", "format": "date", "description": "Booking date" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"], "description": "Booking status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "phone", "email", "guests", "optionId", "date", "status", "createdAt"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "booking",
      "description": "Collection of bookings"
    }
  }
}
